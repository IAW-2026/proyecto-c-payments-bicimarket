# Clerk configuration and keys (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database connection strings (Supabase PostgreSQL)
DATABASE_URL=xxxxxxxxxxxxxxxxx
DIRECT_URL=xxxxxxxxxxxxxxxxx

# Service tokens for inter-app REST authentication
BUYER_TO_PAYMENTS_SERVICE_TOKEN=change-me-buyer-to-payments
SELLER_TO_PAYMENTS_SERVICE_TOKEN=change-me-seller-to-payments
SHIPPING_TO_PAYMENTS_SERVICE_TOKEN=change-me-shipping-to-payments
PAYMENTS_TO_BUYER_SERVICE_TOKEN=change-me-payments-to-buyer
PAYMENTS_TO_SELLER_SERVICE_TOKEN=change-me-payments-to-seller

# Mercado Pago Credentials (https://mercadopago.com.ar/developers)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=your-webhook-signing-secret
MERCADOPAGO_SANDBOX_MODE=true
MERCADOPAGO_WEBHOOK_URL=https://your-app.vercel.app/webhooks/mercadopago

# Inter-app base URLs (other BiciMarket services)
BUYER_APP_URL=https://buyer.bicimarket.com/api/v1
SELLER_APP_URL=https://seller.bicimarket.com/api/v1
SHIPPING_APP_URL=https://shipping.bicimarket.com/api/v1
