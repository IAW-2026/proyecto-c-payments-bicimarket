generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// Type enums
// ============================================

enum PaymentStatus {
  pending
  approved
  rejected
  cancelled
  refunded
}

enum PaymentMethod {
  credit_card
  debit_card
  account_money
  pix
  bank_transfer
}

enum PaymentAttemptStatus {
  pending
  approved
  rejected
  cancelled
}

enum SettlementStatus {
  pending
  paid
  failed
  manual_review
}

enum PayoutStatus {
  pending
  in_progress
  completed
  failed
  manual_review
}

enum RefundStatus {
  pending
  approved
  failed
}

enum RefundReason {
  seller_rejected
  buyer_cancelled
  not_delivered
  manual
}

enum WebhookEventStatus {
  received
  processing
  processed
  failed
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

// Payments app core models
model Payment {
  id                 String          @id @default(cuid())
  order_id           String
  buyer_profile_id   String
  buyer_clerk_user_id String?
  amount_cents       Int
  currency           String          @default("ARS")
  status             PaymentStatus   @default(pending)
  method             PaymentMethod?
  card_last4         String?
  gateway_reference  String?
  idempotency_key    String?         @unique
  items_summary      Json?          // per-seller breakdown for settlement calculation
  approved_at        DateTime?
  rejected_at        DateTime?
  cancelled_at       DateTime?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  deleted_at         DateTime?

  payment_attempts       PaymentAttempt[]
  receipts               Receipt[]
  settlements            Settlement[]
  refunds                Refund[]
  status_history         PaymentStatusHistory[]

  @@index([order_id])
  @@index([status])
}

model PaymentStatusHistory {
  id            String          @id @default(cuid())
  payment_id    String
  payment       Payment         @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  from_status   PaymentStatus?
  to_status     PaymentStatus
  changed_by    String?         // admin user or "system"
  reason        String?
  created_at    DateTime        @default(now())

  @@index([payment_id])
}

model PaymentAttempt {
  id               String               @id @default(cuid())
  payment_id       String
  payment          Payment              @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  attempt_number   Int
  provider         String               @default("mercadopago")
  status           PaymentAttemptStatus @default(pending)
  error_code       String?
  error_message    String?
  request_payload  Json?
  response_payload Json?
  created_at       DateTime             @default(now())

  @@index([payment_id])
}

model Receipt {
  id             String   @id @default(cuid())
  payment_id     String
  payment        Payment  @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  receipt_number String
  receipt_url    String
  amount_cents   Int
  issued_at      DateTime
  created_at     DateTime @default(now())
  deleted_at     DateTime?
}

model Settlement {
  id                    String              @id @default(cuid())
  payment_id            String
  payment               Payment             @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  order_id              String
  order_seller_group_id String
  seller_profile_id     String
  gross_amount_cents    Int
  fee_amount_cents      Int
  net_amount_cents      Int
  currency              String              @default("ARS")
  status                SettlementStatus    @default(pending)
  paid_at               DateTime?
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt
  deleted_at            DateTime?

  payouts        Payout[]
  status_history SettlementStatusHistory[]

  @@unique([payment_id, seller_profile_id])
  @@index([status])
}

model SettlementStatusHistory {
  id           String             @id @default(cuid())
  settlement_id String
  settlement   Settlement         @relation(fields: [settlement_id], references: [id], onDelete: Cascade)
  from_status  SettlementStatus?
  to_status    SettlementStatus
  changed_by   String?
  reason       String?
  created_at   DateTime           @default(now())

  @@index([settlement_id])
}

model Payout {
  id            String       @id @default(cuid())
  settlement_id String
  settlement    Settlement   @relation(fields: [settlement_id], references: [id], onDelete: Cascade)
  transfer_id   String?
  status        PayoutStatus @default(pending)
  attempts      Int          @default(0)
  last_error    String?
  started_at    DateTime?
  completed_at  DateTime?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  deleted_at    DateTime?

  @@index([settlement_id])
}

model Refund {
  id                String       @id @default(cuid())
  payment_id        String
  payment           Payment      @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  seller_profile_id String?
  amount_cents      Int
  currency          String       @default("ARS")
  reason            RefundReason @default(manual)
  status            RefundStatus @default(pending)
  gateway_reference String?
  created_at        DateTime     @default(now())
  updated_at        DateTime     @updatedAt
  deleted_at        DateTime?

  status_history    RefundStatusHistory[]

  @@index([payment_id])
}

model RefundStatusHistory {
  id          String       @id @default(cuid())
  refund_id   String
  refund      Refund       @relation(fields: [refund_id], references: [id], onDelete: Cascade)
  from_status RefundStatus?
  to_status   RefundStatus
  changed_by  String?
  reason      String?
  created_at  DateTime     @default(now())

  @@index([refund_id])
}

model IdempotencyKey {
  id         String   @id @default(cuid())
  key        String   @unique
  response   Json
  status     Int
  created_at DateTime @default(now())
  expires_at DateTime?

  @@index([key])
  @@index([created_at])
}

model MpWebhookEvent {
  id              String            @id @default(cuid())
  mp_event_id     String            @unique
  event_type      String
  payload         Json
  signature_valid Boolean
  processed_at    DateTime?
  last_error      String?
  status          WebhookEventStatus @default(received)
  created_at      DateTime          @default(now())

  @@index([status])
}

model OutboundCallLog {
  id              String    @id @default(cuid())
  target_app      String
  method          HttpMethod
  path            String
  request_body    Json?
  response_status Int?
  response_body   Json?
  attempts        Int       @default(0)
  last_error      String?
  succeeded_at    DateTime?
  created_at      DateTime  @default(now())

  @@index([target_app])
  @@index([succeeded_at])
}
